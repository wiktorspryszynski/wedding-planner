# Random string, min. 32 chars (e.g. `openssl rand -base64 48`). Changing it logs everyone out.
SESSION_SECRET=
# SQLite file location. In Docker this is /app/data/wedding.db (mounted volume).
DATABASE_PATH=./data/wedding.db
# Set to 1 only when testing the production build over plain http://localhost.
INSECURE_COOKIES=
